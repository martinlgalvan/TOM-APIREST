MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_EXPIRES=1h
REFRESH_EXPIRES=365d
ACCESS_RESTORE_EXPIRES=365d
REFRESH_COOKIE_SAMESITE=lax
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,https://planificaciontom.com
QR_LOGIN_URL=https://planificaciontom.com/qr-login
NODE_ENV=production

# Ids de usuario que pueden entrar al panel interno, separados por coma.
# Si esta vacia, nadie entra: el panel falla cerrado a proposito.
SUPERADMIN_IDS=

# Certificado (base64) de la CA que firma el cert de MongoDB. Vacio = sin TLS.
MONGODB_CA=
